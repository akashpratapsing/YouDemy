# Copy to .env at the repository root and fill in real values. NEVER commit real secrets.
# The backend also imports this file automatically when started from backend/.

# Backend / PostgreSQL
# No PostgreSQL? From backend/, run: .\mvnw.cmd spring-boot:run "-Dspring-boot.run.profiles=local"
# to use file-backed H2; the DATABASE_* values below are ignored in that mode.
# DATABASE_URL accepts either a JDBC URL or a standard connection string such as
# postgresql://user:password@host:5432/db?sslmode=require. Credentials embedded in
# the connection string are used when DATABASE_USERNAME/DATABASE_PASSWORD are not set.
# URL-encode special characters in the embedded password (for example @ -> %40).
DATABASE_URL=jdbc:postgresql://localhost:5432/youdemy
DATABASE_NAME=youdemy
DATABASE_USERNAME=youdemy
DATABASE_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# Optional Redis (application works without it)
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS / URLs
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# Frontend (Vite exposes VITE_* to the browser; only public URLs belong here)
# Use /api so the Vite dev proxy and Nginx forward requests to the backend.
VITE_API_BASE_URL=/api
